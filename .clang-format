# The code style of src/. clang-format 22 (Visual Studio's VC\Tools\Llvm\x64\bin), checked with
#	clang-format --dry-run --Werror <files>
# (python -I tools/source_check.py format runs it on the changed sources). src/Extern keeps its own style
# (.clang-format-ignore).
#
# The arguments of PATELLA_ASSERT*, TERROR* and TMYEXCEPTION are stringized into the exception messages:
# clang-format leaves them exactly as written (WhitespaceSensitiveMacros), so that a reformat does not
# change the client's messages. The list names every such macro of src/, the local ones of single files
# included; a new one is added here.
Language: Cpp
BasedOnStyle: LLVM
Standard: Latest

# Tabs of four columns for indentation and continuation, spaces for alignment inside a line.
UseTab: ForContinuationAndIndentation
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
ConstructorInitializerIndentWidth: 4
AccessModifierOffset: -4
IndentCaseLabels: false
IndentPPDirectives: None

# No column limit: the line breaks are the author's. Breaks go before binary operators.
ColumnLimit: 0
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeTernaryOperators: true
AlignAfterOpenBracket: DontAlign
AlignOperands: DontAlign
AlignEscapedNewlines: DontAlign
BreakTemplateDeclarations: Leave

# Function bodies open on their own line, every other brace on the line of its statement.
BreakBeforeBraces: WebKit
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Always
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: true

PointerAlignment: Right
ReferenceAlignment: Pointer

# Trailing comments are aligned over consecutive lines.
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
SpacesBeforeTrailingComments: 1
ReflowComments: false

# Includes keep their order (the Windows headers depend on it).
SortIncludes: Never
FixNamespaceComments: false
MaxEmptyLinesToKeep: 2
KeepEmptyLines:
  AtStartOfBlock: true
  AtStartOfFile: true

StatementMacros:
  - PATELLA_MSVC_WARNING
WhitespaceSensitiveMacros:
  - PATELLA_ASSERT
  - PATELLA_ASSERT_VALUES
  - TERROR
  - TERROR1
  - TERROR2
  - TERROR1B
  - TERROR_REASON
  - TERROR1_REASON
  - TMYEXCEPTION
