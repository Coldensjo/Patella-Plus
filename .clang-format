# The code style of src/ (issue #8; notes/decisions.md, "Compiler settings, warnings and code style
# (issue #8)"): the style the reconstruction was written in. clang-format 22 (Visual Studio's
# VC\Tools\Llvm\x64\bin), checked with
#	clang-format --dry-run --Werror <files>
# src/Extern keeps its own style (.clang-format-ignore).
#
# The arguments of PATELLA_ASSERT*, TERROR* and TMYEXCEPTION are stringized into the exception messages:
# clang-format leaves them exactly as written (WhitespaceSensitiveMacros). The list names every such
# macro of src/, the local ones of single files included; a new one is added here. Until issue #76
# (November 5, 2026) the oracle's tests compared those messages (notes/modernization-plan.md, 4.2, retired);
# the list stays, so that a reformat does not change the client's messages by the way.
Language: Cpp
BasedOnStyle: LLVM
Standard: Latest

# Tabs of four columns for indentation and continuation, spaces for alignment inside a line.
UseTab: ForContinuationAndIndentation
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
ConstructorInitializerIndentWidth: 4
AccessModifierOffset: -4
IndentCaseLabels: false
IndentPPDirectives: None

# No column limit: the line breaks are the author's. Breaks go before binary operators.
ColumnLimit: 0
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeTernaryOperators: true
AlignAfterOpenBracket: DontAlign
AlignOperands: DontAlign
AlignEscapedNewlines: DontAlign
BreakTemplateDeclarations: Leave

# Function bodies open on their own line, every other brace on the line of its statement.
BreakBeforeBraces: WebKit
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Always
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: true

PointerAlignment: Right
ReferenceAlignment: Pointer

# Trailing comments (the addresses and offsets of the original) are aligned over consecutive lines.
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
SpacesBeforeTrailingComments: 1
ReflowComments: false

# Includes keep their order (the Windows headers depend on it).
SortIncludes: Never
FixNamespaceComments: false
MaxEmptyLinesToKeep: 2
KeepEmptyLines:
  AtStartOfBlock: true
  AtStartOfFile: true

# PATELLA_TEST_IDLE and the other PATELLA_TEST_ statements (src/TestHooks.h) are the test mode's calls,
# nothing at all outside the test build.
StatementMacros:
  - PATELLA_MSVC_WARNING
  - PATELLA_TEST_IDLE
  - PATELLA_TEST_RSA_BLOCK
  - PATELLA_TEST_PACKET_SENT
  - PATELLA_TEST_PACKET_RECEIVED
  - PATELLA_TEST_FRAME_OBSERVERS
WhitespaceSensitiveMacros:
  - PATELLA_ASSERT
  - PATELLA_ASSERT_VALUES
  - TERROR
  - TERROR1
  - TERROR2
  - TERROR1B
  - TERROR_REASON
  - TERROR1_REASON
  - TMYEXCEPTION
