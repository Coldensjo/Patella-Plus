# The values someone fixes when building the client for their own server: src/BuildConfig.h and src/BuildConfigDefaults.h
# (the values, the names and the options), src/BuildTexts.h and src/BuildTextsDefaults.h (the texts).
#
# PATELLA_BUILD_CONFIG names a developer's own copy of src/BuildConfigDefaults.h, PATELLA_BUILD_TEXTS one of
# src/BuildTextsDefaults.h (unset by default): the whole build compiles with them through the definitions
# PATELLA_BUILD_CONFIG_FILE and PATELLA_BUILD_TEXTS_FILE, so pulling updates never conflicts with their values.
# src/BuildConfig.h and src/BuildTexts.h apply the same compile-time checks to them. README.md, "Building for your own
# server".
#
# PATELLA_CLIENT_NAME is the config file's ClientName, read here: the client's executable is named after it
# (cmake/WindowsX64.cmake, cmake/LinuxX64.cmake), and so is its Windows version information (src/res/Patella.rc,
# through the generated ClientName.rc.h). The compile checks the value again (src/BuildConfig.h).

include_guard(GLOBAL)

set(PATELLA_BUILD_CONFIG "" CACHE FILEPATH "A developer's own copy of src/BuildConfigDefaults.h (a client for their own server; empty: the defaults)")
set(PATELLA_BUILD_TEXTS "" CACHE FILEPATH "A developer's own copy of src/BuildTextsDefaults.h (a client for their own server; empty: the defaults)")

set(patella_build_config_file "${PROJECT_SOURCE_DIR}/src/BuildConfigDefaults.h")
if(PATELLA_BUILD_CONFIG)
	get_filename_component(patella_build_config_file "${PATELLA_BUILD_CONFIG}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
	if(NOT EXISTS "${patella_build_config_file}" OR IS_DIRECTORY "${patella_build_config_file}")
		message(FATAL_ERROR "PATELLA_BUILD_CONFIG: no such file: ${patella_build_config_file}")
	endif()
	message(STATUS "PATELLA_BUILD_CONFIG: ${patella_build_config_file} replaces src/BuildConfigDefaults.h")
	add_compile_definitions("PATELLA_BUILD_CONFIG_FILE=\"${patella_build_config_file}\"")
endif()

if(PATELLA_BUILD_TEXTS)
	get_filename_component(patella_build_texts_file "${PATELLA_BUILD_TEXTS}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
	if(NOT EXISTS "${patella_build_texts_file}" OR IS_DIRECTORY "${patella_build_texts_file}")
		message(FATAL_ERROR "PATELLA_BUILD_TEXTS: no such file: ${patella_build_texts_file}")
	endif()
	message(STATUS "PATELLA_BUILD_TEXTS: ${patella_build_texts_file} replaces src/BuildTextsDefaults.h")
	add_compile_definitions("PATELLA_BUILD_TEXTS_FILE=\"${patella_build_texts_file}\"")
endif()

# ClientName, from its one line in the config file; a change of the file configures again.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patella_build_config_file}")
file(STRINGS "${patella_build_config_file}" patella_client_name_line
	REGEX "^inline constexpr const char \\*ClientName = \"[^\"]*\";")
list(LENGTH patella_client_name_line patella_client_name_lines)
if(NOT patella_client_name_lines EQUAL 1)
	message(FATAL_ERROR "${patella_build_config_file}: needs exactly one line\n"
		"  inline constexpr const char *ClientName = \"<name>\";\n"
		"(the executable is named after it)")
endif()
string(REGEX MATCH "\"([^\"]*)\"" patella_client_name_quoted "${patella_client_name_line}")
set(PATELLA_CLIENT_NAME "${CMAKE_MATCH_1}")
if(NOT PATELLA_CLIENT_NAME MATCHES "^[A-Za-z0-9_-]+$")
	message(FATAL_ERROR "${patella_build_config_file}: ClientName must be 1 to 31 letters, digits, '-' or '_' (\"${PATELLA_CLIENT_NAME}\")")
endif()
string(LENGTH "${PATELLA_CLIENT_NAME}" patella_client_name_length)
if(patella_client_name_length GREATER 31)
	message(FATAL_ERROR "${patella_build_config_file}: ClientName must be 1 to 31 letters, digits, '-' or '_' (\"${PATELLA_CLIENT_NAME}\")")
endif()
if(NOT PATELLA_CLIENT_NAME STREQUAL "Patella")
	message(STATUS "ClientName: ${PATELLA_CLIENT_NAME} (the executable is ${PATELLA_CLIENT_NAME}${CMAKE_EXECUTABLE_SUFFIX})")
endif()

# The Windows version information's name (src/res/Patella.rc includes it).
set(PATELLA_BUILD_CONFIG_GENERATED "${PROJECT_BINARY_DIR}/buildconfig")
file(CONFIGURE OUTPUT "${PATELLA_BUILD_CONFIG_GENERATED}/ClientName.rc.h" CONTENT
"// Generated by cmake/BuildConfig.cmake from ClientName (src/BuildConfigDefaults.h or PATELLA_BUILD_CONFIG).
#define PATELLA_CLIENT_NAME \"@PATELLA_CLIENT_NAME@\"
#define PATELLA_CLIENT_FILE \"@PATELLA_CLIENT_NAME@.exe\"
" @ONLY NEWLINE_STYLE LF)
